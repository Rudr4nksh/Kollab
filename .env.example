# ==============================================================
# Kollab Environment Configuration
# ==============================================================

# Server Port (default: 4000)
PORT=4000
NODE_ENV=production

# Database Connection (SQLite or PostgreSQL)
# SQLite (Local / Persistent Docker volume):
DATABASE_URL="file:./dev.db"

# Or PostgreSQL (e.g. Supabase, Neon, Railway):
# DATABASE_URL="postgresql://user:password@host:5432/kollab?schema=public"

# Frontend URL (Used for CORS and OAuth redirection)
# Local development: http://localhost:5173
# Production: https://kollab.yourdomain.com (or same as server port)
CLIENT_URL="http://localhost:5173"

# GitHub OAuth Integration (1-Click GitHub login for Git operations)
# Create a free GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: https://kollab.yourdomain.com (or http://localhost:5173 in dev)
# - Authorization Callback URL: https://kollab.yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Assistant Integration (Claude / Gemini / Antigravity / OpenAI)
# Optional: If unset, Kollab's built-in intelligent developer engine operates automatically.
ANTHROPIC_API_KEY="" # Claude 3.5 Sonnet / Haiku
GEMINI_API_KEY=""    # Google Gemini 2.5 Flash / 1.5 Pro
OPENAI_API_KEY=""    # OpenAI GPT-4o / GPT-4o-mini

